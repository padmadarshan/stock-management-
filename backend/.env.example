# StockWise Backend Configuration Example
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/stockwise_db
FALLBACK_SQLITE=true
SQLITE_URL=sqlite:///./stockwise.db
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
